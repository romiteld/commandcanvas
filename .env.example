# Browser-visible Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase credential used by authenticated route handlers
SUPABASE_SECRET_KEY=replace_me

# Server-selected model for direct sketch interpretation. Limited /demo judge-preview users
# supply a temporary key for the current tab. Verified non-anonymous /meet users
# may explicitly save their own key, encrypted through Supabase Vault. There is
# no deployment-owner OpenAI key fallback.
OPENAI_VISION_MODEL=gpt-5.6-terra

# Optional continuous in-page voice through regular gpt-realtime-2.1 WebRTC.
# This switch exposes the feature, but does not provide provider credentials.
# Limited /demo judge-preview users enter a project-scoped key for the current tab. Verified
# non-anonymous /meet users may explicitly save, replace, or delete their own
# encrypted account key. A raw saved key is never returned to the browser.
REALTIME_VOICE_ENABLED=false

# Keep false for the most stable browser behavior. Execute-time guards are
# identical in static and dynamic registration modes.
NEXT_PUBLIC_WEBMCP_DYNAMIC_REGISTRATION=false

# Canonical HTTPS origin used to construct passwordless room invitations.
# Without it, the host can still copy an honest preview link, but the server
# will not submit an invitation email.
COMMANDCANVAS_PUBLIC_URL=
COMMANDCANVAS_INVITE_TOKEN_SECRET=

# Optional server-only Resend HTTPS API credential, verified sender, and
# Standard Webhooks signing secret. Missing submission values produce an honest
# preview-only result and never a delivery claim. Standard authenticated-room
# invitations are host-authorized and do not use a recipient allowlist.
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=

# Meeting-packet recipient safeguard, including public /demo. This is not the
# authenticated-room invitation policy.
COMMANDCANVAS_EMAIL_ALLOWLIST=

# Optional private CUDA hand tracking. These values are read only by the
# CommandCanvas server. When disabled, unavailable, or not explicitly selected
# by the person using the camera, hand tracking stays in the browser.
PRIVATE_HAND_RELAY_ENABLED=false
PRIVATE_HAND_RELAY_ORIGIN=https://hands.example.com
PRIVATE_HAND_RELAY_SIGNING_KEY=
PRIVATE_HAND_RELAY_TOKEN_TTL_SECONDS=60
