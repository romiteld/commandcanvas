# Browser-visible Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase credential used by authenticated route handlers
SUPABASE_SECRET_KEY=replace_me

# Server-only sketch interpretation
OPENAI_API_KEY=replace_me
OPENAI_VISION_MODEL=gpt-5.6-terra

# Optional continuous in-page voice through regular gpt-realtime-2.1 WebRTC.
# This paid capability is disabled unless both values are set. Use a separately
# budgeted server-only key. Microphone audio reaches OpenAI only while the user
# has Live voice on; the provider key never reaches the browser.
REALTIME_VOICE_ENABLED=false
OPENAI_REALTIME_API_KEY=

# Keep false for the most stable browser behavior. Execute-time guards are
# identical in static and dynamic registration modes.
NEXT_PUBLIC_WEBMCP_DYNAMIC_REGISTRATION=false

# Optional real email delivery. Without all three values, CommandCanvas uses
# an honest preview-only result and never claims that email was sent.
RESEND_API_KEY=
RESEND_FROM=
COMMANDCANVAS_EMAIL_ALLOWLIST=
