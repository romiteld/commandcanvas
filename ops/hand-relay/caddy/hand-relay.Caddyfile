hands.autolensai.com {
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
	}

	@relay {
		method GET
		path /v1/capabilities /v1/hand-pose
	}

	handle @relay {
		reverse_proxy 127.0.0.1:8100 {
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
	}

	handle {
		respond "not found" 404
	}

	log {
		output file {$COMMANDCANVAS_HAND_RELAY_ACCESS_LOG:/home/romiteld/Development/AI_ML/commandcanvas/var/log/caddy/hand-relay-access.log} {
			roll_size 10MB
			roll_keep 3
		}
	}
}
