# CommandCanvas native CUDA relay. Copy to a protected environment file outside
# Git before starting Compose. Never reuse an application, Supabase, Resend,
# router, firewall, or another service's secret.

# Exactly 32 random bytes encoded as unpadded base64url. The matching value is
# installed only in the CommandCanvas server environment.
PRIVATE_HAND_RELAY_SIGNING_KEY=

# Exact CommandCanvas web origins only. Wildcards are refused.
PRIVATE_HAND_RELAY_ALLOWED_ORIGINS=https://commandcanvas.example

# CUDA device shared with other processes on the host. The service is neither
# entitled to nor configured for exclusive GPU ownership.
PRIVATE_HAND_RELAY_CUDA_DEVICE=0

# Conservative bounded defaults. Compose supplies the model path and loopback
# listener; these values tune admission rather than changing the protocol.
PRIVATE_HAND_RELAY_MAX_CONNECTIONS=2
PRIVATE_HAND_RELAY_MAX_HANDSHAKES=8
PRIVATE_HAND_RELAY_GPU_MEM_LIMIT_BYTES=805306368
PRIVATE_HAND_RELAY_HANDSHAKE_TIMEOUT_SECONDS=5
PRIVATE_HAND_RELAY_FRAME_IDLE_TIMEOUT_SECONDS=5
# Lifetime of an established, authenticated WebSocket. This is independent of
# the short-lived, one-use capability used only during the opening handshake.
# Allowed range: 60-7200 seconds. Default: 1800 seconds (30 minutes).
PRIVATE_HAND_RELAY_AUTHENTICATED_SESSION_TIMEOUT_SECONDS=1800
PRIVATE_HAND_RELAY_INFERENCE_TIMEOUT_SECONDS=2
